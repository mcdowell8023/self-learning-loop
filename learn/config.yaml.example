# Learning Loop v5.0.5 — 项目级配置示例
#
# 位置：$WORKSPACE/learn/config.yaml（项目级） 或 ~/.openclaw/learn/config.yaml（用户级）
# 加载优先级：环境变量 (OPENCLAW_LEARN_*) > 项目级 > 用户级 > 内置默认值
#
# 环境变量映射规则：OPENCLAW_LEARN_<PATH_UPPER> = value
#   示例：shadow.min_trials → OPENCLAW_LEARN_SHADOW_MIN_TRIALS=5
#
# 热更新：`openclaw learn config reload`（Phase 1 仅 CLI，SIGHUP/file-watch 是 P1b/P2）
# 双缓冲策略：校验失败 → 保持旧配置 + audit config_reload_failed 事件
# Trial 快照：reload 不影响进行中的 trial（在 trial 启动时冻结快照）

# ── 采集层 ──────────────────────────────────────────
collect:
  adapters:
    # v5.0.5：所有 adapter 都走「主路径 + legacy fallback」双字段模式
    - name: openclaw
      enabled: true
      agents_root: "~/.openclaw/agents"           # 主路径：扫描 <root>/*/sessions/*.jsonl
      legacy_session_dir: "~/.openclaw/sessions"  # 老布局兜底（命中时 warn 一次）
    - name: claude-code
      enabled: false                              # Phase 2 才实装
      projects_root: "~/.claude/projects"
      legacy_session_dir: "~/.claude/sessions"
    - name: opencode
      enabled: false                              # Phase 2 才实装
      agents_root: "~/.opencode/agents"
      legacy_session_dir: "~/.opencode/sessions"
  filters:
    min_turns: 3                                  # 忽略 < 3 轮的会话
    min_tool_calls: 1                             # 至少 1 次工具调用才采集
    exclude_labels: ["test", "debug"]
  dedup:
    mode: content_hash_window                     # 事件级去重（§4.4.2）
    window_ms: 30000                              # 30 秒窗口
    prefer_richer_env: true                       # 跨 Runtime 去重偏向 env 信息更丰富的一条
    trial_dedup_key: "candidate_id+runtime+session_id"  # Trial 级三元组

# ── 反思层 ──────────────────────────────────────────
reflect:
  model: "claude-sonnet-4.6"
  fallback_model: "gpt-5-mini"
  prompt_path: "$WORKSPACE/learn/prompts/reflect.md"
  cron: "30 22 * * *"                             # 默认每晚 22:30
  max_candidates_per_session: 3
  temperature: 0.3

# ── Shadow 验证层 ───────────────────────────────────
shadow:
  min_trials: 3
  max_trials: 10
  max_daily: 5
  observation_mode: "passive"                     # passive | active（Phase 2+）
  sample_bias_protection:
    enabled: true
    min_unique_sessions: 2
    max_same_session_ratio: 0.6

# ── 决策层 ──────────────────────────────────────────
decision:
  confidence_threshold:
    high: 0.7                                     # ≥ high → auto_decide
    low: 0.5                                      # < low  → escalate
  l3_enabled: false                               # L3 LLM judge 先关
  l3_model: "claude-sonnet-4.6"
  sandbox:
    chain: ["bwrap", "firejail", "docker"]        # 降级链
    timeout_ms: 10000
    timeout_max_ms: 60000
  cluster:
    auto_decide_enabled: true
    significance_thresholds:
      turns_delta_pct: 15
      turns_delta_abs: 2
      errors_delta: 1
      token_delta_pct: 20
      completion_rate_delta_pct: 10
    post_decision_validation_days: 5
    auto_rerun_max: 2

# ── 毕业层 ──────────────────────────────────────────
graduation:
  scope_routes:
    general: "AGENTS.md"
    role: "agents/{role}.md"
    tool: "TOOLS.md"
    skill: "skills/{skill_name}/SKILL.md"
  softlink: true
  rollback_keep: 3
  skill_packaging:
    enabled: false                                # Phase 2+
    output_dir: "$WORKSPACE/skills/auto-generated/"

# ── EvoMap Bridge（P1a 可留空）──────────────────────
bridge:
  endpoint: null                                  # null = 离线
  a2a_enabled: false
  credit_limit: 100
  auto_publish: false
  sensitive_patterns:
    - "(?i)api[_-]?key"
    - "(?i)secret"
    - "192\\.168\\."
    - "/home/\\w+/"

# ── Parliament Hook（P1a 默认关）────────────────────
parliament:
  enabled: false
  endpoint: null
  risk_escalation_rules: ["R1", "R2", "R3", "R4", "R5", "R6", "R7"]
  timeout_ms: 30000

# ── 存储 ───────────────────────────────────────────
storage:
  base_dir: "$WORKSPACE/learn"
  audit_dir: "$WORKSPACE/learn/audit"
  candidates_dir: "$WORKSPACE/learn/candidates"
  clusters_dir: "$WORKSPACE/learn/clusters"
  max_jsonl_size_kb: 500
